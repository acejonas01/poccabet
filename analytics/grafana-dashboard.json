    {
      "id": 5,
      "type": "timeseries",
      "title": "Staked, paid out and GGR per day",
      "datasource": "grafana-postgresql-datasource",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "grafana-postgresql-datasource",
          "rawSql": "SELECT day::timestamp AS time, stake_ngn AS \"Staked\", payouts_ngn AS \"Paid out\", ggr_ngn AS \"GGR\" FROM v_daily_kpis WHERE $__timeFilter(day::timestamp) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:₦",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "GGR"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Staked"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Paid out"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Players per day",
      "datasource": "grafana-postgresql-datasource",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "grafana-postgresql-datasource",
          "rawSql": "SELECT day::timestamp AS time, signups AS \"Sign-ups\", active_logins AS \"Logged in\", active_bettors AS \"Placed a bet\" FROM v_daily_kpis WHERE $__timeFilter(day::timestamp) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "GGR by league (settled bets, all time)",
      "datasource": "grafana-postgresql-datasource",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "grafana-postgresql-datasource",
          "rawSql": "SELECT league AS \"League\", country AS \"Country\", bets AS \"Bets\", stake_ngn AS \"Staked\", payouts_ngn AS \"Paid out\", ggr_ngn AS \"GGR\" FROM v_ggr_by_league ORDER BY stake_ngn DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Staked|Paid out|GGR"
            },
            "properties": [
              {
                "id": "unit",
                "value": "prefix:₦"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      }
    },
