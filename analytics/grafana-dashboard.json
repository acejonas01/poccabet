{
  "title": "Poccabet — Business overview",
  "uid": "poccabet-overview",
  "timezone": "Africa/Lagos",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "poccabet"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GGR (selected period)",
      "description": "Stakes minus payouts of bets settled in the period",
      "datasource": "grafana-postgresql-datasource",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "grafana-postgresql-datasource",
          "rawSql": "SELECT coalesce(sum(ggr_ngn),0) AS ggr FROM v_daily_kpis WHERE $__timeFilter(day::timestamp)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:₦",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
