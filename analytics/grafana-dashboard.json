    {
      "id": 9,
      "type": "table",
      "title": "Top players by amount staked (all time)",
      "datasource": "grafana-postgresql-datasource",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "grafana-postgresql-datasource",
          "rawSql": "SELECT display_name AS \"Player\", signup_source AS \"Came from\", bets AS \"Bets\", days_active AS \"Days active\", stake_ngn AS \"Staked\", payouts_ngn AS \"Paid out\", ggr_ngn AS \"GGR\", bonuses_ngn AS \"Bonuses\", balance_ngn AS \"Balance\", last_bet_at AS \"Last bet\" FROM v_player_value WHERE bets > 0 ORDER BY stake_ngn DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
